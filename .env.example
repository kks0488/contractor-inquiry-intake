# Documentation only: the app reads environment variables, not dotenv files.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_MODEL=nvidia/Nemotron-3_5-Lightning
# Set LLM_API_KEY in your shell; omit it for the offline rule-based fallback.

# Optional Google Sheets mirror; keep credentials outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/credentials.json
# GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_SHEET_RANGE='Inquiries!A:N'

# Optional owner notification. Set SLACK_WEBHOOK_URL in your shell.
